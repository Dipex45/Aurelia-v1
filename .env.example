# Production Environment Setup Example for AURELIA OPS
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aurelia_ops

# Security and Authentication
JWT_SECRET=SUPER_LONG_RANDOM_SECRET

# Background Queue / Cache (Redis)
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Email Service Integration (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# Deployment Domains
APP_URL=https://app.aureliaops.com
CORS_ORIGIN=https://app.aureliaops.com
